{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {"driver": {"name": "example-scanner"}},
      "results": [
        {"ruleId": "py/sql-injection", "level": "error", "message": {"text": "Query built from user input"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "db.py"}, "region": {"startLine": 2}}}]},
        {"ruleId": "py/sql-injection", "level": "error", "message": {"text": "Unsanitized query executed"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "db.py"}, "region": {"startLine": 7}}}]},
        {"ruleId": "py/unsafe-render", "level": "warning", "message": {"text": "Unescaped output"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "reports.py"}, "region": {"startLine": 3}}}]},
        {"ruleId": "py/dead-helper", "level": "note", "message": {"text": "Weak cleanup routine"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "legacy.py"}, "region": {"startLine": 2}}}]},
        {"ruleId": "py/hardcoded-secret", "level": "error", "message": {"text": "Hard-coded secret key"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app.py"}, "region": {"startLine": 7}}}]},
        {"ruleId": "py/outdated-dependency", "level": "warning", "message": {"text": "Dependency with known issue"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "requirements.txt"}, "region": {"startLine": 3}}}]}
      ]
    }
  ]
}
